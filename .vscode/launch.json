{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "coreclr",
            "request": "launch",
            "name": ".NET Launch API (Development)",
            "program": "${workspaceFolder}/Boardgame-Management.Api/bin/Debug/net9.0/Boardgame-Management.Api.dll",
            "cwd": "${workspaceFolder}/Boardgame-Management.Api",
            "preLaunchTask": "build-api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7053;http://localhost:5047"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+https?://localhost:([0-9]+)",
                "uriFormat": "https://localhost:%s/Scalar/"
            }
        },
        {
            "type": "coreclr",
            "request": "launch",
            "name": ".NET Launch API (Production)",
            "program": "${workspaceFolder}/Boardgame-Management.Api/bin/Debug/net9.0/Boardgame-Management.Api.dll",
            "cwd": "${workspaceFolder}/Boardgame-Management.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production",
                "ASPNETCORE_URLS": "https://localhost:7054;http://localhost:5048"
            }
        }
    ]
}
